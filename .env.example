# Browser (Vite) — used to load the PayPal JS SDK. Public, not secret.
VITE_PAYPAL_CLIENT_ID=

# ---- Vercel environment variables (Project > Settings > Environment Variables) ----
# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supabase (server-side only — never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Déesse Shop <onboarding@resend.dev>
STORE_EMAIL=
# Optional: Resend Audience id to collect newsletter subscribers
RESEND_AUDIENCE_ID=